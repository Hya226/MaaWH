    // ============ 速通弹窗校验（防止误点编队页角色）============
    // 分叉容器：命中「速通战斗」弹窗 → 正常调次数；4s 未命中（点偏了/误入编队页）
    // → on_error 走「返回战前」重试。注意 on_error 必须挂在容器节点上才生效。
    "刷谷_速通判定": {
        "action": "DoNothing",
        "timeout": 6000,
        "next": [
            "刷谷_速通校验"
        ],
        "on_error": [
            "刷谷_返回战前"
        ]
    },
    "刷谷_速通校验": {
        "recognition": "TemplateMatch",
        "template": "sutong_dialog.png",
        "threshold": 0.7,
        "action": "DoNothing",
        "next": [
            "刷谷_调次数"
        ]
    },
    // 误入编队页时，左上角「器者列表」按钮返回战前准备页；最多重试 3 次（max_hit）防死循环
    "刷谷_返回战前": {
        "action": "Click",
        "target": [107, 33],
        "post_delay": 1500,
        "max_hit": 3,
        "next": [
            "SuTongClick"
        ]
    },

    // ============ 次数调节 ============
    // 弹窗内 ROI（x 730~1120, y 300~385）限定，避免「−」这类简单图形在其它页面误匹配
    // 连按「−」9 次触底（值恒为 1），再按「+」到目标次数
    "刷谷_调次数": {
        "recognition": "TemplateMatch",
        "template": "sutong_minus.png",
        "threshold": 0.85,
        "roi": [566, 300, 390, 85],
        "action": "Click",
        "repeat": 9,
        "repeat_delay": 350,
        "next": [
            "刷谷_加次数"
        ]
    },
    // 目标次数 - 1（初始已在 1）；pre_delay 等触底提示消失
    // interface.json 的「刷冬谷币次数」option 覆盖本节点 repeat
    "刷谷_加次数": {
        "recognition": "TemplateMatch",
        "template": "sutong_plus.png",
        "threshold": 0.85,
        "roi": [566, 300, 390, 85],
        "action": "Click",
