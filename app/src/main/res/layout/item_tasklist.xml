<?xml version="1.0" encoding="utf-8"?>
<!-- 任务列表行：左侧勾选框 + 任务名 + 右侧编辑入口（整行可单击选中编辑）。
     行高由 CheckBox 的 minHeight 决定（Material 默认 48dp），收紧到 34dp 让队列更紧凑 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingTop="1dp"
    android:paddingEnd="2dp"
    android:paddingBottom="1dp">

    <CheckBox
        android:id="@+id/itemCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="34dp" />

    <!-- 任务名按自身宽度（永远看得见），参数摘要占剩下的地方并截断 ——
         摘要过长（如「太阳神鸟 · 洛神赋图 · 蛙锣」）时不能把任务名挤成 0 宽 -->
    <TextView
        android:id="@+id/itemName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/itemCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:paddingEnd="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/itemDel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="6dp"
        android:text="✕"
        android:textColor="@color/err_red"
        android:textSize="16sp" />
</LinearLayout>