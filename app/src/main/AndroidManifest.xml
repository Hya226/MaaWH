<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Shizuku API v23 权限（旧版 Shizuku Manager 需要） -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 保活：任务/虚拟屏存活期间挂前台服务，避免被 ColorOS 当缓存进程清理（见 KeepAliveService） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ 前台服务通知可见；被拒也不影响服务运行 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 「防后台被杀设置」里为 MaaWH/Shizuku 申请忽略电池优化 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 任务运行中切后台时显示悬浮进度条（对标 MAA-Meow 的悬浮面板，见 FloatingPanel） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 应用内更新：访问 GitHub Releases API 与下载安装包 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 拉起系统安装器安装下载的新 APK（用户需在系统设置允许「安装未知应用」） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 定时任务（对标 maameow 的定时页，见 ScheduleManager）：调度首选 setAlarmClock
         （准点且豁免 Doze，实测 ColorOS 会把 setExactAndAllowWhileIdle 按 policy_permission
         降级成 1 小时窗口，所以不拿精确闹钟 API 当首选）。权限声明仍然必须（2026-10 用户
         实测：部分 ROM 把 setAlarmClock 的精确闹钟豁免收紧成「未声明权限一律 SecurityException」，
         这就是「点保存闪退」的根因；maameow 同样按「setAlarmClock 也要权限」处理）：
         - USE_EXACT_ALARM：Android 13+ 自动授予且不可撤销（canScheduleExactAlarms 恒 true），
           行为与声明前完全一致；ExactAlarmPolicy 是 Play 商店政策 lint，本应用不上 Play，
           声明即可（maameow 同款做法）。
         - SCHEDULE_EXACT_ALARM：兜 Android 12/12L（该权限 13 才引入 USE_EXACT_ALARM；
           12 上声明即默认授予，用户可在设置里撤销——撤销后 ScheduleManager 降级 set +
           定时页提示卡引导，授权广播回来 BootReceiver 自动重挂）。
         RECEIVE_BOOT_COMPLETED：开机/覆盖安装后重挂闹钟（闹钟不跨重启，见 BootReceiver）；
         WAKE_LOCK：触发时点亮屏幕（部分 ROM 熄屏把虚拟屏一起断电，帧流会黑屏） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        tools:ignore="ExactAlarmPolicy" />

    <!-- Android 11+ 包可见性：不声明这个，本应用查不到 Shizuku 的包信息——
         getPackageInfo 抛 NameNotFoundException、getLaunchIntentForPackage 返回 null，
         于是"Shizuku 已运行但未授权"会被错报成"未安装 Shizuku"，"打开 Shizuku"按钮也点不动 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <!-- 自定义 Application：把界面整体缩放（DisplayScale）挂到 applicationContext，
         悬浮窗用 applicationContext 建视图，只在 Activity 层包一层管不到它 -->
    <application
        android:name=".MaaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaaWH">

        <!-- ShizukuProvider：让 Shizuku Manager 与 App 建立授权通信 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 应用内更新：向系统安装器共享下载好的 APK -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 任务运行中 / 虚拟屏存活时的保活前台服务（targetSdk 34 必须声明 FGS 类型） -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="longRunningAutomation" />
        </service>

        <!-- 定时任务：闹钟到期触发（显式 PendingIntent 指名，无需导出/无需 intent-filter） -->
        <receiver
            android:name=".ScheduleReceiver"
            android:exported="false" />
        <!-- 定时任务：开机/覆盖安装/时区变更/精确闹钟授权恢复后重挂全部闹钟
             （后两个是系统保护广播，exported=false 即可收到；授权恢复广播 31+ 才有，
             低版本收不到也无害。ACTION_RESYNC 是 App 内部显式投递，无需 intent-filter） -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.MaaWH"
            android:screenOrientation="portrait" />
        <activity
            android:name=".VdFullscreenActivity"
            android:exported="false"
            android:theme="@style/Theme.MaaWH"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
