// ============================================================================
// MaaWH 抽卡记录抓取 · 坐标配置
//
// ★ 所有坐标以 1280x720 虚拟屏帧为基准（FrameSave 抓的 cur_frame.jpg）。
// ★ 2026-09-18：坐标已由人工框选填写，并用 gacha/_measure.py 在
//   frame_dropdown.jpg 上做了像素级比对验证（10 条行带、裁剪框全覆盖、
//   点击点均在容差内）。colors 由同一帧的饱和像素标定。
//
// 填写约定：
//   "click"     填按钮/选项的【中心点】[x, y]
//   crop/region 填矩形的【左上角 + 宽高】[x, y, w, h]
//
// 注：本文件允许 // 注释行，App 读取时会自动剥掉。
// ============================================================================
{
  "version": 2,
  "vd": { "w": 1280, "h": 720 },

  // 四个池子的名字，顺序即抓取顺序（名字要和下拉框选项显示的完全一致——
  // 注意游戏里是「招集渠道」不是「招募渠道」，uid 也用这个叫法）
  "pools": ["限时渠道", "限定渠道", "招集渠道", "征集渠道"],

  "click": {
    // 记录页右上角的池子下拉框（当前显示「限时渠道 ▼」的按钮）中心
    "dropdown": [1132, 155],

    // 点开下拉框后，四个池子选项各自的中心
    "poolOption": {
      "限时渠道": [1134, 201],
      "限定渠道": [1139, 246],
      "招集渠道": [1139, 293],
      "征集渠道": [1139, 338]
    },

    // 底部分页栏「下一页」按钮中心
    "nextPage": [1018, 584],
    // 「上一页」按钮中心（备用，翻页异常排查用）
    "prevPage": [466, 584],
    // 页码数字「1」的中心（切池后强制回第一页的兜底点击）
    "pageOne": [543, 588]
  },

  "crop": {
    // 三个矩形的框选范围：从「第一行文字上沿」到「最后一行文字下沿」，
    // 不能把表头（稀有度/器者/时间）和底部页码栏框进去。

    // 器者名字整列（送 OCR）。实测行文字 y 228~542、名字 x 537~624，本框全覆盖
    "nameCol": { "x": 414, "y": 220, "w": 332, "h": 329 },

    // 时间整列（送 OCR）。实测时间文字 x 980~1178，本框全覆盖
    "timeCol": { "x": 924, "y": 220, "w": 301, "h": 331 },

    // 招集列（小类，如「限时/至乐如真」，送 OCR）。实测文字 x 779~888
    "zhaoCol": { "x": 770, "y": 220, "w": 150, "h": 331 },

    // 稀有度文字竖条：行定位和取色都在这条里做。实测扫到 10 条行带
    "rarityStrip": { "x": 308, "y": 216, "w": 53, "h": 333 }
  },

  // 表格整体区域：只用于翻页前后「画面有没有变化」的比对，大框即可
  "table": {
    "fullRegion": { "x": 254, "y": 220, "w": 777, "h": 329 }
  },

  // 「下一页」按钮区域（人工实测精确值：定位点击在此范围内找按钮块）
  "pagerStrip": { "x": 972, "y": 567, "w": 93, "h": 36 },

  // 「暂无记录」字样可能出现的大致区域（空页判定辅助）
  // ⚠ 待确认：这个框是从真实的空池子页面上量的吗？
  "emptyHint": { "region": { "x": 700, "y": 331, "w": 115, "h": 116 } },

  // 稀有度基准色 RGB。2026-09-18 由 frame_dropdown.jpg 饱和像素标定。
  // 运行时分类按「色相方向 + 饱和度下限」匹配，不要求逐通道相等，
  // 因此 JPEG 压缩造成的轻微失真不影响判定。
  "colors": {
    "特出": [205, 70, 85],
    "优异": [205, 190, 85],
    "新生": [55, 160, 148]
  },

  // 各步操作后的保底等待毫秒数（翻页另有「画面稳定检测」自适应兜底，一般不用改）
  "timings": {
    "afterNextMs": 400,
    "afterDropdownMs": 500,
    "afterPoolSwitchMs": 600
  },

  // OCR 小图放大倍数，一般不用改
  "ocr": {
    "upscale": 2
  }
}
